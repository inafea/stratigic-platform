# Copy to .env and fill in.

# --- Option A: Claude (Anthropic) -- key from https://console.anthropic.com
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-your-key-here
# claude-opus-5-5 (best) | claude-sonnet-5-5 | claude-haiku-5-5 (cheapest)
LLM_MODEL=claude-opus-5-5
# Claude effort: low | medium | high | xhigh | max (empty = model default)
LLM_EFFORT=

# --- Option B: GitHub Models (OpenAI-compatible)
# LLM_PROVIDER=github
# LLM_API_KEY=your-github-token
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_BASE_URL=https://models.github.ai/inference

# --- Option C: offline demo with sample data (no key needed)
# LLM_PROVIDER=fake

LLM_TIMEOUT_SECONDS=120
# Database: SQLite for development, PostgreSQL (e.g. Neon) for staging/production.
# Paste the provider's URL as is (postgresql://...?sslmode=require); the app picks the psycopg driver.
DATABASE_URL=sqlite:///./mustashar.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/mustashar?sslmode=require
# Owner of reports created before user accounts existed (set a password later via "forgot password")
ADMIN_EMAIL=admin@localhost
RATE_LIMIT=10/minute
LOG_LEVEL=INFO

# --- Accounts ---
# COOKIE_SECURE=true            # in production (HTTPS)
PUBLIC_URL=http://127.0.0.1:8000
# Email: console prints emails to the server log; smtp sends them
MAIL_BACKEND=console
# MAIL_FROM=Mustashar <no-reply@your-domain.com>
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Sign in with Google: create an OAuth client (Web application) in Google Cloud Console.
# Authorized redirect URI: {PUBLIC_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- AI model per plan tier (empty = LLM_MODEL). Free uses lite, Entrepreneur standard, Pro/Business/packs premium.
# LLM_MODEL_LITE=gemini-3.5-flash-lite
# LLM_MODEL_STANDARD=gemini-3.5-flash
# LLM_MODEL_PREMIUM=gemini-3.8-flash
# CONTACT_EMAIL=you@your-domain.com   # Contact us messages are emailed here
